# Server Configuration
PORT=3100
NODE_ENV=development
HOST=localhost

# Exact API CORS origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# AI Provider Configuration
# Set your Gemini API key (Required for real AI responses)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (Defaults to gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional Fallback Model
GEMINI_FALLBACK_MODEL=gemini-1.5-flash

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
MAX_REQUEST_BODY_SIZE=1mb

# Dynamic API discovery (server-registered integrations only; disabled by default)
DYNAMIC_API_DISCOVERY_ENABLED=false
API_DISCOVERY_ALLOWED_HOSTS=localhost
API_DISCOVERY_TIMEOUT_MS=5000
API_DISCOVERY_MAX_SPEC_BYTES=1048576

# Local HirePool integration (development only; never enable in production)
ENABLE_HIREPOOL_LOCAL_BRIDGE=false
HIREPOOL_LOCAL_API_BASE_URL=http://localhost:8000/
HIREPOOL_LOCAL_OPENAPI_URL=http://localhost:8000/api/openapi.json
HIREPOOL_LOCAL_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Session Configuration
SESSION_TTL_MS=7200000
MAX_CONTEXT_MESSAGES=20
