# Server Configuration
PORT=3000
NODE_ENV=development
HOST=localhost

# AI Provider Configuration
# Set AI_PROVIDER explicitly when selecting a provider. mock is disabled in production.
# If unset, available provider credentials are selected by deterministic factory priority.
# AI_PROVIDER=openai # Options: gemini, groq, openai, mock
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Session Configuration
SESSION_TTL_MS=7200000
MAX_CONTEXT_MESSAGES=20

# Authentication & Authorization Configuration
# AUTH_MODE options: 'none' (development only), 'jwt', 'api-key', 'hybrid'
# Production endpoints require authentication; configure a supported mode and secret.
# Never expose JWT_SECRET or API_KEY to the browser.
AUTH_MODE=none
AUTH_REQUIRED=false
# Enable only the separately maintained HirePool action definitions.
ENABLE_HIREPOOL_INTEGRATION=false
# Secret key used to verify HS256 JWT tokens (required when AUTH_MODE=jwt or AUTH_REQUIRED=true)
JWT_SECRET=your_jwt_secret_here
# Optional JWT claims verification
# JWT_ISSUER=your_issuer_here
# JWT_AUDIENCE=your_audience_here
# Optional server API key for service-to-service authentication (required when AUTH_MODE=api-key)
# API_KEY=your_service_api_key_here
